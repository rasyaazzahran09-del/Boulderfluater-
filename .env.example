# ============================================================
#  KONFIGURASI BOT — salin file ini menjadi .env, lalu isi nilainya
#  Simpan .env di folder yang sama dengan index.js
# ============================================================

# Token Bot Telegram (dapatkan dari @BotFather)
BOT_TOKEN=

# GitHub Personal Access Token
# Buat di: https://github.com/settings/tokens
# Centang permission: repo (full), workflow
GITHUB_TOKEN=

# Username GitHub kamu
GITHUB_OWNER=

# Nama repository GitHub UTAMA yang dipakai untuk build APK
GITHUB_REPO=Boulderfluater-

# ────────────────────────────────────────────────────────────
#  MULTI-REPO POOL (fitur baru)
# ────────────────────────────────────────────────────────────
# Daftar repo yang dipakai untuk build, dipisahkan koma.
# Jika ada build di repo 1, build selanjutnya otomatis pindah ke repo kosong.
# Jika hanya pakai 1 repo, cukup isi GITHUB_REPO saja dan kosongkan ini.
# Contoh: Boulderfluater-,Boulderfluater-2,Boulderfluater-3
GITHUB_REPOS=Boulderfluater-,Boulderfluater-2,Boulderfluater-3

# Buat repo baru secara otomatis jika belum ada di GitHub (true/false).
# Bot akan membuat repo private dan push workflow otomatis.
AUTO_CREATE_REPOS=true

# (Opsional) ID Telegram admin, pisahkan dengan koma.
ADMIN_IDS=
ALLOWED_USERS=

# ────────────────────────────────────────────────────────────
#  LIMIT UKURAN FILE — bisa di-override admin lewat command
# ────────────────────────────────────────────────────────────
MAX_ZIP_MB=50
MAX_APK_SEND_MB=50

# ────────────────────────────────────────────────────────────
#  FIX "file is too big" — Local Telegram Bot API Server
# ────────────────────────────────────────────────────────────
LOCAL_BOT_API_AUTOSTART=false
LOCAL_BOT_API_BINARY=./bin/telegram-bot-api
LOCAL_BOT_API_PORT=8081
LOCAL_BOT_API_DIR=./local_bot_api_data
LOCAL_BOT_API_LOG=./logs/telegram-bot-api.log

# Credentials Telegram API (BUKAN BOT_TOKEN).
# Dapatkan di: https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

TELEGRAM_API_BASE_URL=
TELEGRAM_DOWNLOAD_LIMIT_MB=19.5

# ────────────────────────────────────────────────────────────
#  FOTO START + WAJIB JOIN CHANNEL
# ────────────────────────────────────────────────────────────
START_PHOTO=start.jpg
REQUIRED_CHANNELS=
REQUIRED_CHANNEL_LINKS=

# ────────────────────────────────────────────────────────────
#  USERBOT PENGIRIM APK (GramJS)
# ────────────────────────────────────────────────────────────
USERBOT_STRING_SESSION=
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_PHONE=
USERBOT_PANEL_LOGIN=false

# ────────────────────────────────────────────────────────────
#  WEB PANEL
# ────────────────────────────────────────────────────────────
WEB_PANEL_PORT=10882
WEB_PANEL_PUBLIC_URL=
# WEB_PANEL_SECRET=
